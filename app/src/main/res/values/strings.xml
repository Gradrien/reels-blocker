    <string name="onb_a11y_title">Let Reels Blocker see Instagram</string>
    <string name="onb_a11y_body">Android calls this an accessibility service. Reels Blocker only reads the names of Instagram\'s screens, never your messages, photos or videos.</string>
    <string name="onb_a11y_how">Find “Reels Blocker” in the list (sometimes under “Downloaded apps”) and turn it on.</string>
    <string name="onb_a11y_restricted">Switch greyed out? Android blocks this for apps installed outside the Play Store. Open App info, tap ⋮, then “Allow restricted settings”, and try again.</string>
    <string name="onb_a11y_action">Open Accessibility settings</string>
    <string name="onb_open_app_info">Open App info</string>
