    <string name="onb_done">Done</string>
    <string name="onb_next">Next</string>
    <string name="onb_battery_title">Keep it running</string>
    <string name="onb_battery_body">Some phones stop apps that run in the background, Xiaomi, Huawei and Samsung especially. In App info, set Battery to “Unrestricted” and, if you see it, turn on Autostart.</string>
    <string name="onb_notif_title">Get warned if it stops</string>
    <string name="onb_notif_body">If Android turns protection off, Reels Blocker can send you a notification to turn it back on. Nothing else, ever.</string>
    <string name="onb_notif_action">Allow notifications</string>
