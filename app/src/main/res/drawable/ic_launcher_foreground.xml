<?xml version="1.0" encoding="utf-8"?>
<!-- White "play" glyph struck through by a bar. The gap around the bar reuses the background
     gradient in the same coordinates, so it reads as a cut-out. Its coordinates are
     pre-scaled by 1/0.62 to undo the group scale. -->
